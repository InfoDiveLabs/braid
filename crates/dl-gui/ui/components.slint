// The pieces a transfer row is built from.
//
// Drawn from mockup/macos/main.jpg. Every glyph here is a `Path` or a
// `Rectangle` rather than a character: a glyph missing from the system face
// renders as nothing at all, with no error and no fallback box.

import { Theme } from "theme.slint";
import { Platform } from "@platform";

// One interface's contribution to a transfer, as a fraction of the whole.
//
// `start` and `span` are precomputed in Rust: a running total is not
// expressible in `.slint`, and a child sized from `parent.width` inside a
// layout is a binding loop, because the layout's own size depends on it.
export struct Segment {
    start: float,
    span: float,
    color-index: int,
}

// One line of the transfer list.
//
// HTTP and BitTorrent share this struct rather than branching on a type: the
// row draws what is present and omits what is not. `detail` carries peers and
// upload for a torrent and is empty for a download; `depth` indents a file
// inside a torrent. A third kind of transfer should mean filling in different
// fields, not a third row component.
export struct TransferRow {
    id: int,
    /// Where the bytes come from: "http" | "torrent" | "file"
    kind: string,
    /// What the bytes are: "folder" | "disk" | "archive" | "doc" | "video"
    /// | "image" | "app" | "file". Shown beside the source glyph, because a
    /// list is scanned by shape before it is read.
    file: string,
    filename: string,
    progress: float,
    /// Right-hand primary line, e.g. "47% · 30.0 MB of 64.0 MB · 3.8 MB/s".
    status: string,
    /// Right-hand secondary line. Empty unless the transfer has peers.
    detail: string,
    /// "running" | "paused" | "queued" | "done" | "error" | "seeding"
    state: string,
    segments: [Segment],
    /// 0 for a transfer, 1 for a file inside one.
    depth: int,
    expandable: bool,
    expanded: bool,
    /// True for an expanded transfer and every file beneath it, so the group
    /// reads as one object rather than as rows that happen to be adjacent.
    grouped: bool,
}

// What kind of link an interface is. Keys match `dl_net::InterfaceKind::icon`,
// so a kind added there renders as the neutral globe rather than as nothing.
export component LinkGlyph inherits Rectangle {
    in property <string> kind;
    in property <color> ink;

    width: 15px;
    height: 15px;

    if root.kind == "wifi": Path {
        width: 15px; height: 15px; viewbox-width: 15; viewbox-height: 15;
        commands: "M 1.4 5.2 A 9 9 0 0 1 13.6 5.2"
            + " M 3.9 8.1 A 5.4 5.4 0 0 1 11.1 8.1"
            + " M 6.3 10.9 A 2 2 0 0 1 8.7 10.9"
            + " M 7.5 13.4 L 7.5 13.5";
        stroke: root.ink;
        stroke-width: 1.3px;
    }
    if root.kind == "ethernet": Path {
        width: 15px; height: 15px; viewbox-width: 15; viewbox-height: 15;
        commands: "M 2.2 5.6 L 12.8 5.6 L 12.8 11.4 L 2.2 11.4 Z"
            + " M 5.1 5.6 L 5.1 2.6 L 9.9 2.6 L 9.9 5.6"
            + " M 4.6 8.2 L 4.6 9.6 M 7.5 8.2 L 7.5 9.6 M 10.4 8.2 L 10.4 9.6";
        stroke: root.ink;
        stroke-width: 1.2px;
    }
    if root.kind == "cellular": Path {
        width: 15px; height: 15px; viewbox-width: 15; viewbox-height: 15;
        commands: "M 2 12.4 L 2 10.2 M 5.7 12.4 L 5.7 7.8"
            + " M 9.4 12.4 L 9.4 5.2 M 13.1 12.4 L 13.1 2.6";
        stroke: root.ink;
        stroke-width: 1.5px;
    }
    if root.kind == "vpn": Path {
        width: 15px; height: 15px; viewbox-width: 15; viewbox-height: 15;
        commands: "M 7.5 1.6 L 13 4 L 13 8 A 7 7 0 0 1 7.5 13.6"
            + " A 7 7 0 0 1 2 8 L 2 4 Z";
        stroke: root.ink;
        stroke-width: 1.2px;
    }
    if root.kind == "bridge": Path {
        width: 15px; height: 15px; viewbox-width: 15; viewbox-height: 15;
        commands: "M 2 11 L 2 7.4 A 5.5 5.5 0 0 1 13 7.4 L 13 11"
            + " M 7.5 11 L 7.5 5.2 M 2 11 L 13 11";
        stroke: root.ink;
        stroke-width: 1.2px;
    }
    if root.kind == "loopback": Path {
        width: 15px; height: 15px; viewbox-width: 15; viewbox-height: 15;
        commands: "M 3.4 5.4 A 4.4 4.4 0 1 1 3.4 9.6"
            + " M 3.4 5.4 L 3.4 2.8 M 3.4 5.4 L 6 5.4";
        stroke: root.ink;
        stroke-width: 1.3px;
    }
    // The neutral globe, for "network" and anything unrecognised.
    if root.kind != "wifi" && root.kind != "ethernet" && root.kind != "cellular"
        && root.kind != "vpn" && root.kind != "bridge" && root.kind != "loopback": Path {
        width: 15px; height: 15px; viewbox-width: 15; viewbox-height: 15;
        commands: "M 7.5 1.5 A 6 6 0 1 1 7.49 1.5"
            + " M 7.5 1.5 A 3 6 0 1 1 7.49 1.5"
            + " M 1.5 7.5 L 13.5 7.5";
        stroke: root.ink;
        stroke-width: 1.2px;
    }
}

// What the transfer is, as opposed to where it comes from.
export component FileGlyph inherits Rectangle {
    in property <string> file;
    in property <color> ink;

    width: 15px;
    height: 17px;

    if root.file == "folder": Path {
        width: 15px; height: 13px; viewbox-width: 15; viewbox-height: 13;
        commands: "M 0.7 2.2 L 5.4 2.2 L 6.8 4 L 14.3 4 L 14.3 12.3 L 0.7 12.3 Z";
        stroke: root.ink;
        stroke-width: 1.2px;
    }
    if root.file == "disk": Rectangle {
        width: 14px; height: 14px;
        border-radius: 7px;
        border-width: 1.2px;
        border-color: root.ink;
        Rectangle { x: 5.5px; y: 5.5px; width: 3px; height: 3px;
            border-radius: 1.5px; background: root.ink; }
    }
    if root.file == "archive": Path {
        width: 13px; height: 16px; viewbox-width: 13; viewbox-height: 16;
        commands: "M 0.7 0.7 L 12.3 0.7 L 12.3 15.3 L 0.7 15.3 Z"
            + " M 6.5 0.7 L 6.5 4 M 5.2 5.6 L 7.8 5.6 M 5.2 8 L 7.8 8";
        stroke: root.ink;
        stroke-width: 1.2px;
    }
    if root.file == "video": Path {
        width: 15px; height: 12px; viewbox-width: 15; viewbox-height: 12;
        commands: "M 0.7 0.7 L 14.3 0.7 L 14.3 11.3 L 0.7 11.3 Z"
            + " M 0.7 3.4 L 3 3.4 M 0.7 8.6 L 3 8.6 M 12 3.4 L 14.3 3.4 M 12 8.6 L 14.3 8.6";
        stroke: root.ink;
        stroke-width: 1.2px;
    }
    if root.file == "image": Path {
        width: 15px; height: 12px; viewbox-width: 15; viewbox-height: 12;
        commands: "M 0.7 0.7 L 14.3 0.7 L 14.3 11.3 L 0.7 11.3 Z"
            + " M 0.7 8.4 L 4.6 4.5 L 7.6 7.5 L 9.9 5.2 L 14.3 9.2";
        stroke: root.ink;
        stroke-width: 1.2px;
    }
    if root.file == "app": Path {
        width: 14px; height: 14px; viewbox-width: 14; viewbox-height: 14;
        commands: "M 0.7 0.7 L 13.3 0.7 L 13.3 13.3 L 0.7 13.3 Z"
            + " M 4.7 3.8 L 4.7 10.2 L 9.3 7 Z";
        stroke: root.ink;
        stroke-width: 1.2px;
    }
    // The neutral page, for "doc" and anything unrecognised.
    if root.file != "folder" && root.file != "disk" && root.file != "archive"
        && root.file != "video" && root.file != "image" && root.file != "app": Path {
        width: 13px; height: 16px; viewbox-width: 13; viewbox-height: 16;
        commands: "M 0.7 0.7 L 8 0.7 L 12.3 5 L 12.3 15.3 L 0.7 15.3 Z"
            + " M 8 0.7 L 8 5 L 12.3 5";
        stroke: root.ink;
        stroke-width: 1.2px;
    }
}

// The progress bar. A live transfer is broken into one span per interface, so
// bandwidth aggregation is visible rather than hidden behind a single number.
export component ProgressBar inherits Rectangle {
    in property <float> progress;
    in property <[Segment]> segments;
    in property <string> state;
    /// Drawn on a selected row, where the accent fill is behind it.
    ///
    /// The per-interface segments collapse to one colour here on purpose: the
    /// copper band would vanish into a copper row, and at four pixels tall the
    /// breakdown was never readable anyway. Selecting a row is how the
    /// Inspector opens, and that is where the split belongs.
    in property <bool> inverted;

    property <bool> live: root.state == "running" && !root.inverted;

    height: 4px;
    border-radius: 2px;
    // Well clear of every surface behind it: when the track matched its
    // container, a transfer at 2% looked like a bar that was not there.
    background: root.inverted ? #00000038 : Theme.track;
    clip: true;

    // A finished transfer is a single fact. Breaking it into interfaces would
    // be a muted rainbow that reads as a fault.
    if !root.live: Rectangle {
        x: 0;
        y: 0;
        width: root.width * root.progress;
        height: root.height;
        background: root.inverted ? Theme.on-accent
            : root.state == "seeding" || root.state == "done" ? Theme.upload
            : root.state == "error" ? Theme.danger : Theme.text-faint;
        animate width { duration: 260ms; easing: ease-out; }
    }

    if root.live: Rectangle {
        for seg in root.segments: Rectangle {
            x: root.width * root.progress * seg.start;
            y: 0;
            width: root.width * root.progress * seg.span;
            height: root.height;
            background: Theme.interface-colors[Math.mod(seg.color-index, 5)];
            // An ease, not a spring: progress is a measurement, and overshoot
            // would briefly display more of it than exists.
            animate width, x { duration: 260ms; easing: ease-out; }
        }
    }
}

export component Meter inherits Rectangle {
    in property <float> fill;
    in property <color> tint;

    height: 3px;
    border-radius: 1.5px;
    background: Theme.track;
    clip: true;

    Rectangle {
        x: 0;
        y: 0;
        width: root.width * Math.clamp(root.fill, 0.0, 1.0);
        height: root.height;
        border-radius: 1.5px;
        background: root.tint;
        animate width { duration: 400ms; easing: ease-out; }
    }
}

// Where a transfer's bytes come from: one server, or many peers.
export component KindGlyph inherits Rectangle {
    in property <string> kind;
    in property <color> ink;

    width: 16px;
    height: 16px;

    if root.kind == "http": Rectangle {
        width: 15px;
        height: 15px;
        border-radius: 7.5px;
        border-width: 1.3px;
        border-color: root.ink;
        Path {
            width: 15px; height: 15px; viewbox-width: 15; viewbox-height: 15;
            commands: "M 0.8 7.5 L 14.2 7.5"
                + " M 7.5 0.6 C 4.4 3.6 4.4 11.4 7.5 14.4"
                + " M 7.5 0.6 C 10.6 3.6 10.6 11.4 7.5 14.4";
            stroke: root.ink;
            stroke-width: 1.1px;
        }
    }

    if root.kind == "torrent": Path {
        width: 16px; height: 16px; viewbox-width: 16; viewbox-height: 16;
        commands: "M 3.4 3.4 L 11.4 8 M 3.4 12.6 L 11.4 8";
        stroke: root.ink;
        stroke-width: 1.3px;
    }
    if root.kind == "torrent": Rectangle {
        x: 0.6px; y: 0.6px; width: 5.2px; height: 5.2px;
        border-radius: 2.6px; border-width: 1.3px; border-color: root.ink;
    }
    if root.kind == "torrent": Rectangle {
        x: 0.6px; y: 9.8px; width: 5.2px; height: 5.2px;
        border-radius: 2.6px; border-width: 1.3px; border-color: root.ink;
    }
    if root.kind == "torrent": Rectangle {
        x: 9.8px; y: 5.2px; width: 5.2px; height: 5.2px;
        border-radius: 2.6px; background: root.ink;
    }
}

// The chevron on a transfer that has files inside it. Rotated by swapping the
// path, because Slint has no rotation on a `Path`.
export component Disclosure inherits Rectangle {
    in property <bool> open;
    in property <bool> shown;
    callback toggled;

    width: 12px;
    height: 12px;

    accessible-role: button;
    accessible-label: root.open ? "Collapse" : "Expand";
    accessible-action-default => { root.toggled(); }

    if root.shown: Path {
        width: 9px; height: 9px; viewbox-width: 9; viewbox-height: 9;
        commands: root.open ? "M 0.6 2.6 L 4.5 6.5 L 8.4 2.6"
            : "M 2.6 0.6 L 6.5 4.5 L 2.6 8.4";
        stroke: touch.has-hover ? Theme.text : Theme.text-faint;
        stroke-width: 1.5px;
    }

    touch := TouchArea {
        clicked => { root.toggled(); }
    }
}

export component PlayPauseButton inherits Rectangle {
    in property <bool> paused;
    in property <string> label;
    /// Read by the row: a child TouchArea takes hover from its parent, so
    /// without this the row believes the pointer left the moment it reaches
    /// the button, and fades the button out from under the cursor.
    out property <bool> hovered: touch.has-hover;
    callback clicked;

    property <color> ink: touch.has-hover ? Theme.text : Theme.text-muted;

    width: 24px;
    height: 24px;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.border : transparent;
    animate background { duration: 120ms; }

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    Rectangle {
        visible: !root.paused;
        x: 8px; y: 7px; width: 2.6px; height: 10px;
        border-radius: 1.3px; background: root.ink;
    }
    Rectangle {
        visible: !root.paused;
        x: 13.4px; y: 7px; width: 2.6px; height: 10px;
        border-radius: 1.3px; background: root.ink;
    }
    Path {
        visible: root.paused;
        x: 9px; y: 7px; width: 8px; height: 10px;
        commands: "M 0 0 L 8 5 L 0 10 Z";
        fill: root.ink;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component RemoveButton inherits Rectangle {
    in property <string> label;
    out property <bool> hovered: touch.has-hover;
    callback clicked;

    property <color> ink: touch.has-hover ? Theme.danger : Theme.text-faint;

    width: 22px;
    height: 22px;
    border-radius: 11px;
    background: touch.has-hover ? Theme.danger.transparentize(0.8) : transparent;
    animate background { duration: 120ms; }

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    Path {
        x: 7px; y: 7px; width: 8px; height: 8px;
        viewbox-width: 8; viewbox-height: 8;
        commands: "M 0 0 L 8 8 M 8 0 L 0 8";
        stroke: root.ink;
        stroke-width: 1.5px;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// One row of the transfer list: a download, a torrent, or a file inside one.
//
// The second status line appears only when there is one, which is what lets a
// torrent and a download share a component instead of branching.
export component TransferLine inherits Rectangle {
    in property <TransferRow> item;
    in property <bool> selected;
    callback toggle();
    callback remove();
    callback expand();
    callback select();

    property <bool> child-row: root.item.depth > 0;
    // On a selected row every ink flips to the colour that reads on the
    // accent. Kept as one property so a new label cannot be added in the
    // wrong colour by forgetting the condition.
    property <color> ink: root.selected ? Theme.on-accent : Theme.text;
    property <color> ink-muted: root.selected ? Theme.on-accent.transparentize(0.25)
        : Theme.text-muted;
    property <color> ink-faint: root.selected ? Theme.on-accent.transparentize(0.45)
        : Theme.text-faint;
    property <bool> stopped: root.item.state == "paused" || root.item.state == "queued";
    // Counts the buttons' own hover as well as the row's: a control that fades
    // out as the pointer lands on it cannot be hit.
    property <bool> controls-lit: touch.has-hover || pause-btn.hovered || remove-btn.hovered;

    height: root.child-row ? 32px : Platform.transfer-row-height;
    // A seeding transfer is the one thing here that is giving rather than
    // taking, and the tint is how the list says so without a badge.
    background: root.selected ? Theme.accent
        : root.item.state == "seeding" ? Theme.upload.transparentize(0.88)
        : root.item.grouped ? Theme.surface
        : touch.has-hover ? Theme.surface : transparent;
    animate background { duration: 120ms; }

    accessible-role: list-item;
    accessible-label: root.item.filename;
    accessible-item-selected: root.selected;
    accessible-item-selectable: true;
    // Read back by the screenshot harness. Asserting on pixels alone cannot
    // tell a working UI from a stale snapshot, so state is assertable too.
    accessible-value: root.item.filename + " " + Math.round(root.item.progress * 100) + "% "
        + root.item.state;

    touch := TouchArea {
        clicked => { root.select(); }
    }

    HorizontalLayout {
        padding-left: root.child-row ? 52px : 14px;
        padding-right: 14px;
        spacing: 8px;

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            width: root.child-row ? 0px : 12px;
            Disclosure {
                shown: root.item.expandable;
                open: root.item.expanded;
                toggled => { root.expand(); }
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            width: root.child-row ? 0px : 16px;
            KindGlyph {
                kind: root.item.kind;
                ink: root.selected ? root.ink-muted
                    : root.item.state == "seeding" ? Theme.upload : Theme.text-muted;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            width: 15px;
            FileGlyph {
                file: root.item.file;
                ink: root.ink-faint;
            }
        }

        // Name and status share a row, and the bar runs beneath both: in the
        // design it reaches the right edge rather than stopping where the
        // filename does.
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.item.filename;
                    font-family: Theme.font;
                    font-size: root.child-row ? 12px : 13px;
                    color: root.selected ? root.ink
                        : root.stopped ? Theme.text-muted : Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle { }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    width: root.child-row ? 54px : 250px;
                    spacing: 2px;
                    Text {
                        text: root.item.status;
                        font-family: Theme.mono;
                        font-size: root.child-row ? 10px : 11px;
                        color: root.selected ? root.ink-muted
                            : root.item.state == "seeding" ? Theme.upload
                            : root.stopped ? Theme.text-faint : Theme.text-muted;
                        horizontal-alignment: right;
                    }
                    if root.item.detail != "": Text {
                        text: root.item.detail;
                        font-family: Theme.mono;
                        font-size: 10px;
                        color: root.ink-faint;
                        horizontal-alignment: right;
                    }
                }
            }

            if !root.child-row: ProgressBar {
                progress: root.item.progress;
                segments: root.item.segments;
                state: root.item.state;
                inverted: root.selected;
            }
        }

        // Instantiated even on a child row, which shows none: an id declared
        // inside an `if` cannot be read from outside it, and `controls-lit`
        // has to see both of these.
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            width: root.child-row ? 0px : 24px;
            pause-btn := PlayPauseButton {
                visible: !root.child-row;
                opacity: root.controls-lit ? 1.0 : 0.0;
                animate opacity { duration: 120ms; }
                paused: root.item.state != "running";
                label: (root.item.state == "running" ? "Pause " : "Resume ") + root.item.filename;
                clicked => { root.toggle(); }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            width: root.child-row ? 0px : 22px;
            remove-btn := RemoveButton {
                visible: !root.child-row;
                opacity: root.controls-lit ? 1.0 : 0.0;
                animate opacity { duration: 120ms; }
                label: "Remove " + root.item.filename;
                clicked => { root.remove(); }
            }
        }
    }
}
