/target
**/*.rs.bk
*.pdb
.DS_Store

# Build and capture output, regenerated by `cargo xtask`.
# `assets/` is the committed subset the README points at.
/artifacts
/dist
/packaging/linux/icons

# Working notes and design records, not part of the source release.
/docs
/mockup

# Assistant tooling.
/.claude
CLAUDE.md
AGENTS.md

# Generated by `xtask package` for the Windows installer.
/crates/dl-gui/wix/braid.ico
/crates/dl-gui/wix/License.rtf
/crates/dl-gui/wix/LICENSE.txt

# harness/ runtime state: container volumes and one run's raw captures, both
# specific to whichever machine ran the harness last. Nothing under
# harness/recordings/ is source; the curated, sanitised subset of it lives in
# crates/dl-server/tests/fixtures/ instead, and that is what is committed.
/harness/data
/harness/recordings
